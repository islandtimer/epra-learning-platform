# Database Configuration
DATABASE_URL=postgresql://username:password@localhost:5432/epra_db

# JWT Secrets (generate secure random strings)
JWT_SECRET=your-super-secure-jwt-secret-here
REFRESH_TOKEN_SECRET=your-super-secure-refresh-secret-here

# API Keys
CLAUDE_API_KEY=your-claude-api-key-here
CLAUDE_PROJECT_ID=your-claude-project-id-here
PERPLEXITY_API_KEY=your-perplexity-api-key-here

# Server Configuration
PORT=3001
NODE_ENV=production
FRONTEND_URL=https://your-domain.railway.app